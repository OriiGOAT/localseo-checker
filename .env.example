# Application Configuration
NEXT_PUBLIC_APP_URL=https://yourdomain.vercel.app

# Google PageSpeed Insights API
# Get from: https://console.cloud.google.com/
# Steps:
#   1. Create a new project in Google Cloud Console
#   2. Enable PageSpeed Insights API
#   3. Create an API key (Restrict to PageSpeed Insights API)
NEXT_PUBLIC_PAGESPEED_API_KEY=AIzaSy...

# Stripe Configuration
# Get from: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...

# Stripe Webhook Secret
# Get from: https://dashboard.stripe.com/webhooks
# After setting up webhook endpoint: https://yourdomain.vercel.app/api/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend Email Service
# Get from: https://resend.com/api-keys
# Free tier: emails must come from onboarding@resend.dev
# Pro tier: can use custom domain after verification
RESEND_API_KEY=re_...
